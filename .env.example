# Copy this file to .env and fill in values as needed.
# The application works fully without external keys (deterministic local demo mode).

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# In local development, leave blank to use local SQLite (agentshield.db).
# For production (e.g., Vercel), provide your hosted PostgreSQL connection string
# from Neon (https://neon.tech) or Supabase (https://supabase.com):
# Example: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Optional AI Integration (Server-side only)
# ---------------------------------------------------------------------------
# If supplied, Gemini will be used for AI document summarization.
# Never committed or exposed to the frontend.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Optional Frontend API Base URL
# ---------------------------------------------------------------------------
# Only needed if deploying frontend and backend as separate projects/domains.
# Leave blank for unified/monorepo deployments (defaults to /api).
# Example: https://agentshield-api.vercel.app/api
VITE_API_BASE=
